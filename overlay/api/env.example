# Copy this file to api/.env and edit it for your deployment.
# Use comma-separated origins. Do not add a trailing slash.
# Add every Vercel theme project that will call this API.
G5_CORS_ALLOWED_ORIGINS=https://gnuboard5-nextjs-default.vercel.app,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003,http://127.0.0.1:3004

# A PHP-hosted install (root or sub-folder) needs none of the constants below:
# the bridge and the API derive every URL from Gnuboard's own G5_URL.
# Define them in a PHP extend file only when the app lives on another origin
# (for example a Vercel preview) or to restrict which hosts the bridge trusts:
# define('G5_WEBAPP_APP_URL', 'https://gnuboard5-nextjs-default.vercel.app');

# Optional. Extra web hosts allowed for social OAuth redirects.
# If omitted, G5_CORS_ALLOWED_ORIGINS is also used for social redirect host checks.
G5_SOCIAL_WEB_HOSTS=gnuboard5-nextjs-default.vercel.app

# Optional. Comma-separated reverse proxy REMOTE_ADDR values whose
# X-Forwarded-Proto / X-Forwarded-Host headers may be trusted by PHP.
# Same-host nginx/PHP-FPM normally needs no value because loopback is trusted.
# Example: G5_TRUSTED_PROXY_REMOTE_ADDRS=10.0.0.10,172.16.0.5
G5_TRUSTED_PROXY_REMOTE_ADDRS=

# Optional. Comma-separated mobile app schemes allowed for social OAuth deep links.
# The default includes dday-app.
G5_SOCIAL_MOBILE_SCHEMES=dday-app

# Optional. Nicepay mobile WebView return URLs.
# Leave blank for normal mobile browsers. Set these only when the shop checkout
# is embedded in an app WebView and the Nicepay manual/app guide requires them.
# If Nicepay support asks you to use the current manual PC script, uncomment
# SHOP_PG_NICEPAY_SCRIPT_URL and confirm a test payment before going live.
# SHOP_PG_NICEPAY_SCRIPT_URL=https://pg-web.nicepay.co.kr/v3/common/js/nicepay-pgweb.js
# SHOP_PG_NICEPAY_WAP_URL=myshop://nicepay-return
# SHOP_PG_NICEPAY_ISP_CANCEL_URL=https://your-project.example.com/shop/payment/isp-cancel

# Optional. Auth cookie policy. Omit these for same-origin/reverse-proxy deployments:
# cookies default to SameSite=Lax and Secure is auto-detected from HTTPS/proxy headers.
# For split HTTPS origins using HttpOnly cookies with credentials: include, uncomment both:
# G5_AUTH_COOKIE_SAMESITE=None
# G5_AUTH_COOKIE_SECURE=1

# Optional. 검색엔진 노출 (Next.js 테마 설치본). 기본은 전부 off — 켜야 검색엔진에 보인다.
# 테마 브리지가 요청 때 이 파일을 읽는다(빌드 다시 할 필요 없음). 서버 환경변수가 있으면 그것이 우선.
#   G5_NEXTJS_SEO                 on: 공개 화면 색인 허용, robots.txt 에 사이트맵 안내
#                                 off(기본): 모든 화면 noindex, robots.txt 전체 차단, 사이트맵 비움
#   G5_NEXTJS_SEO_SITEMAP         on: 사이트맵에 게시판·글·분류·상품·기획전·안내 페이지를 DB 에서 넣는다(1시간 캐시)
#                                 off(기본): 사이트맵에 고정 페이지만(DB 를 읽지 않음). SEO 가 off 면 무시
#   G5_NEXTJS_SEO_EXCLUDE_BOARDS  색인·사이트맵에서 뺄 게시판(쉼표로 구분)
#   G5_NEXTJS_SEO_SITEMAP_LIMIT   사이트맵 최대 주소 수(기본 5000, 최대 50000)
# 비회원이 못 보는 것(읽기·목록 권한 2 이상 게시판, 비밀글, 성인·본인 인증 분류와 그 상품)은 설정과 무관하게 늘 뺀다.
# G5_NEXTJS_SEO=on
# G5_NEXTJS_SEO_SITEMAP=on
# G5_NEXTJS_SEO_EXCLUDE_BOARDS=qa
# G5_NEXTJS_SEO_SITEMAP_LIMIT=5000
