# Public PHP/Gnuboard REST API URL. This NEXT_PUBLIC_* value is embedded in the
# browser bundle, so it must be reachable by end users.
NEXT_PUBLIC_API_URL=http://localhost/api/v1

# Optional server-only API URL used by the Next.js proxy/server runtime.
# Leave empty or omit it to fall back to NEXT_PUBLIC_API_URL. Set a different
# value only when the server can reach a private origin/internal proxy that
# should not be exposed to browsers.
G5_API_INTERNAL_URL=http://localhost/api/v1

# Original Gnuboard site URL for assets and cross-links.
NEXT_PUBLIC_G5_URL=http://localhost

# Public Next.js app URL used for metadata and RSS links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Login provider. Keep g5-jwt for static theme/Vercel deployments.
# authjs is reserved for future server-runtime deployments.
NEXT_PUBLIC_AUTH_MODE=g5-jwt

# Comma-separated board IDs rendered as gallery boards.
NEXT_PUBLIC_GALLERY_BOARDS=n_gallery,gallery

# Optional extra HTTP hosts accepted by next/image in local/static preview.
# Defaults already include localhost and common 127.0.0.x Gnuboard dev hosts.
NEXT_IMAGE_LOCAL_HOSTS=

# Optional extra HTTPS image hosts accepted by next/image.
# Example: cdn.example.com,images.example.net
NEXT_IMAGE_EXTRA_HOSTS=

# Optional. Comma-separated reverse proxy REMOTE_ADDR values (IP or CIDR) whose
# X-Forwarded-Proto / X-Forwarded-Host headers may be trusted by PHP.
# Same-host nginx/PHP-FPM normally needs no value because loopback is trusted for these.
# The API also takes the visitor IP from X-Forwarded-For only when REMOTE_ADDR is listed here
# (loopback is NOT trusted for that). It is used for rate limits and the PG deposit-notice IP check.
# List only proxies that append the real visitor to X-Forwarded-For (nginx
# $proxy_add_x_forwarded_for, Cloudflare, a load balancer). If a Next.js server on this host
# proxies /api/v1 behind nginx, add 127.0.0.1 — and keep the Next.js port closed to the internet.
G5_TRUSTED_PROXY_REMOTE_ADDRS=

# Editable design source under nextjs/themes/<name>.
# G5_THEME_NAME controls the Gnuboard output folder; this controls source styling/components.
G5_THEME_SOURCE=default
