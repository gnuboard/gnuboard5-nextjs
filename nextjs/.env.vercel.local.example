# Copy this file to .env.vercel.local for local Vercel release checks.
# The copied .env.vercel.local file is ignored by git and is loaded after
# .env.local by scripts/check-release-vercel.mjs.
#
# Shell environment variables still win over this file.

NEXT_PUBLIC_API_URL=https://your-gnuboard.example.com/api/v1
# Optional. When omitted, the server runtime proxy falls back to NEXT_PUBLIC_API_URL.
# G5_API_INTERNAL_URL=https://your-gnuboard.example.com/api/v1
NEXT_PUBLIC_G5_URL=https://your-gnuboard.example.com
NEXT_PUBLIC_AUTH_MODE=g5-jwt
NEXT_PUBLIC_GALLERY_BOARDS=n_gallery,gallery
NEXT_IMAGE_EXTRA_HOSTS=your-gnuboard.example.com

# Optional strict smoke samples for deterministic release approval.
# SERVER_RUNTIME_SMOKE_POST_PATH=/free/6
# SERVER_RUNTIME_SMOKE_POST_TEXT=Sample post title
# SERVER_RUNTIME_SMOKE_PRODUCT_PATH=/shop/1446772772
# SERVER_RUNTIME_SMOKE_PRODUCT_TEXT=Sample product name

# Optional. 검색엔진 노출 (Vercel / server runtime). 기본은 전부 off — 켜야 검색엔진에 보인다.
# Vercel 에서는 프로젝트 환경변수로 넣고 다시 배포한다. 테마 설치본은 api/.env 의 같은 이름을 쓴다.
# G5_NEXTJS_SEO=on
# G5_NEXTJS_SEO_SITEMAP=on
# G5_NEXTJS_SEO_EXCLUDE_BOARDS=qa
# G5_NEXTJS_SEO_SITEMAP_LIMIT=5000
