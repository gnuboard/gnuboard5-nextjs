# Copy values into your shell environment or a local runner before Playwright E2E.
# Do not commit real credentials.

PLAYWRIGHT_BASE_URL=http://localhost:3000

# General authenticated browser/API checks
LOCAL_SMOKE_LOGIN_ID=
LOCAL_SMOKE_LOGIN_PASSWORD=

# Alias names also supported by simple Playwright specs
E2E_LOGIN_ID=
E2E_LOGIN_PASSWORD=

# Optional checkout/API flow
RUN_SHOP_E2E=0
