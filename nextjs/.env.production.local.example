# Local-only override for `npm run build:theme`.
# Copy to `.env.production.local`; that copied file is intentionally gitignored.
#
# Static theme builds are portable by default: NEXT_PUBLIC_API_URL,
# NEXT_PUBLIC_G5_URL, NEXT_PUBLIC_APP_URL and G5_API_INTERNAL_URL are replaced
# by the placeholder https://__g5host__/__g5base__ at build time and the PHP
# bridge fills in the real install URL when serving. The values below only
# apply to `next dev` and to builds run with G5_PORTABLE_BUILD=0.
# NEXT_PUBLIC_API_URL is browser-visible. G5_API_INTERNAL_URL is server-only and
# may be omitted when it is the same as NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_URL=http://localhost/api/v1
G5_API_INTERNAL_URL=http://localhost/api/v1
NEXT_PUBLIC_G5_URL=http://localhost
NEXT_PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_AUTH_MODE=g5-jwt
NEXT_PUBLIC_GALLERY_BOARDS=n_gallery,gallery
G5_TRUSTED_PROXY_REMOTE_ADDRS=
G5_THEME_SOURCE=default
