# Copy these values to .env.production.local, Vercel environment variables,
# or your deployment secret store. Do not ship a reusable theme with a
# maintainer-owned production domain baked into the build.
#
# NEXT_PUBLIC_API_URL=https://your-domain.example/api/v1
# G5_API_INTERNAL_URL=https://your-domain.example/api/v1
# NEXT_PUBLIC_G5_URL=https://your-domain.example
# NEXT_PUBLIC_APP_URL=https://your-domain.example
# G5_TRUSTED_PROXY_REMOTE_ADDRS=
NEXT_PUBLIC_AUTH_MODE=g5-jwt
NEXT_PUBLIC_GALLERY_BOARDS=n_gallery,gallery

# Static export budget defaults for reusable theme packages.
# The PHP bridge serves non-prebuilt dynamic routes through sentinel shells,
# so keep the default build fast and let site owners raise these values when
# they want more post/product pages pre-rendered into the package.
G5_STATIC_POST_PARAM_LIMIT=80
G5_STATIC_POST_BOARD_LIMIT=8
G5_STATIC_POST_TOTAL_LIMIT=300
G5_STATIC_PRODUCT_PARAM_LIMIT=300
